# Copy this file to .env and fill in your real values
# .env is never uploaded to GitHub

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-...

# Google Docs OAuth
GOOGLE_CLIENT_ID=xxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Nanoleaf devices (add more if needed)
NANOLEAF_1_LABEL=Non-Door
NANOLEAF_1_IP=192.168.x.x
NANOLEAF_1_PORT=16021
NANOLEAF_1_TOKEN=your_token_here

NANOLEAF_2_LABEL=Door
NANOLEAF_2_IP=192.168.x.x
NANOLEAF_2_PORT=16021
NANOLEAF_2_TOKEN=your_token_here
